# Build artifacts: every CMake build dir lives under build/<name>, and the
# compiled WASM delivery (simulator.js/.wasm) lands in build/ top-level.
# build-*/ also ignored to catch any legacy top-level build dirs.
build/
build-*/

# IDE
.vscode/
.idea/
.claude/

# macOS
.DS_Store

# Node (if ever used)
node_modules/

# Emscripten cache
.emscripten_cache/

# CMake
CMakeUserPresets.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Python virtual environments
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# Compiled driver binaries from notebook codegen
modeling/notebooks/exported_cpp/**/driver
modeling/notebooks/exported_cpp/**/_driver

# out data (log, profile)
out_data/*

# Ephemeral benchmark report (regenerated per run; docs/benchmark.md is committed)
benchmark-report.md
